PORT=8080

# UI origins allowed to call the API (comma-separated). The backend is agnostic —
# it never serves a UI, so every consuming origin must be listed here.
CORS_ORIGINS="http://localhost:5173"

# better-auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BASE_URL="http://localhost:8080"

# Public HTTPS origin of the API in production (used in auth redirects + emails).
# Falls back to BASE_URL when empty.
BETTER_AUTH_URL=""

# Comma-separated list of UI origins allowed for auth (cookies/redirects).
# Falls back to CORS_ORIGINS when empty.
BETTER_AUTH_TRUSTED_ORIGINS=""

# Email delivery for better-auth (verification + password reset):
#   console — log the email to stdout (default, dev)
#   smtp    — send via nodemailer using SMTP_URL / SMTP_FROM
EMAIL_PROVIDER=console
SMTP_URL=""
SMTP_FROM=""

# Trust x-forwarded-* proxy headers (base-URL inference + client IP for
# rate limiting). Set to 1 only when running behind a trusted reverse proxy.
TRUST_PROXY=0

# Explicit dev-only auth bypass flag.
# Set to 1 ONLY in local dev to enable the x-user-id impersonation header. Never in production.
# Bypass requires AUTH_DEV_BYPASS=1 AND NODE_ENV !== 'production' AND no Authorization header.
AUTH_DEV_BYPASS=0

# Supabase Postgres (transaction pooler, IPv4-only)
DATABASE_URL="postgresql://postgres.[YOUR-PASSWORD]@aws-0-eu-west-2.pooler.supabase.com:6543/postgres"

# Supabase project — used only for STORAGE URLs (spatial/captures routes).
# Leave empty for dev; set real values for Supabase storage uploads.
# (Auth no longer uses Supabase — better-auth handles it.)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# ---------------------------------------------------------------------------
# STAGING / PRODUCTION
# ---------------------------------------------------------------------------
# Copy this file to .env on the staging host and override the values below.
#
#   NODE_ENV=production            # disables the x-user-id dev bypass
#   AUTH_DEV_BYPASS=0              # must stay 0 in staging/production
#   CORS_ORIGINS="https://staging.example.com,https://admin.staging.example.com"
#   BETTER_AUTH_URL="https://api.staging.example.com"   # public HTTPS origin
#   BETTER_AUTH_TRUSTED_ORIGINS="https://staging.example.com,https://admin.staging.example.com"
#   TRUST_PROXY=1                  # only when behind a reverse proxy
#   EMAIL_PROVIDER=smtp            # real email delivery (set SMTP_URL / SMTP_FROM)
#   DATABASE_URL="postgresql://..."  # staging Postgres (Supabase pooler)
#   SUPABASE_URL="https://<project>.supabase.co"
#   SUPABASE_SERVICE_ROLE_KEY="..."
#
# Build & run:
#   bun run build    # bundles src/index.ts -> dist/index.js (bun target)
#   bun run start    # runs the built bundle (dist/index.js)
# Smoke tests (against a running server):
#   SERVER_URL=https://api.staging.example.com bun test
