PORT=8080
FRONTEND_DIR=../frontend

# better-auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BASE_URL="http://localhost:8080"

# dev-only auth bypass (ignored in production): x-user-id: <uuid>
# Set x-user-id to a seeded user id to act as that user without a cookie.

# Supabase Postgres (transaction pooler, IPv4-only)
DATABASE_URL="postgresql://postgres.[YOUR-PASSWORD]@aws-0-eu-west-2.pooler.supabase.com:6543/postgres"

# Supabase project — leave empty for dev (auth middleware falls back to x-user-id header);
# set real values to enforce Supabase JWT auth.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
