PORT=8080
# Client SPA static files — must point at the BUILT output (../frontend/dist
# after `bun run build`). The React source tree can't be served raw.
FRONTEND_DIR=../frontend/dist

# better-auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BASE_URL="http://localhost:8080"

# dev-only auth bypass (ignored in production): x-user-id: <uuid>
# Set x-user-id to a seeded user id to act as that user without a cookie.

# Supabase Postgres (transaction pooler, IPv4-only)
DATABASE_URL="postgresql://postgres.[YOUR-PASSWORD]@aws-0-eu-west-2.pooler.supabase.com:6543/postgres"

# Supabase project — used only for STORAGE URLs (spatial/captures routes).
# Leave empty for dev; set real values for Supabase storage uploads.
# (Auth no longer uses Supabase — better-auth handles it.)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
